{
  "tasks": {
    "dev": "deno run ./src/main.ts",
    "ui": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "imports": {
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.0",
    "bootstrap": "npm:bootstrap@^5.3.7",
    "bootstrap-icons": "npm:bootstrap-icons@^1.13.1",
    "sass": "npm:sass@^1.89.2",
    "vite": "npm:vite@^7.0.4",
    "vue": "npm:vue@^3.5.17"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
